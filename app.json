{
  "expo": {
    "name": "windfields-connect",
    "slug": "windfields-connect",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "windfieldsconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smaranp.windfields-connect",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1.1.1"
    },
    "android": {
      "package": "com.pinisettystudios.windfieldsconnect",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9F7Iw4pz2B_ngClJCs58xuA3-DpVLQZM"
        }
      }
    },
    "edgeToEdgeEnabled": true,
    "predictiveBackGestureEnabled": false,
    "extra": {
      "eas": {
        "projectId": "0c5380e2-0b06-49ab-a05e-9ae4421b2f1f"
      }
    }
  },
  "web": {
    "output": "static",
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    ],
    "@react-native-community/datetimepicker",
    [
      "@react-native-google-signin/google-signin",
      {
        "iosUrlScheme": "com.googleusercontent.apps.460155358748-kqj5567q74376r1loet0tm6h7a7o0u2m"
      }
    ],
    [
      "expo-build-properties",
      {
        "ios": {
          "useFrameworks": "static"
        }
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  },
  "extra": {
    "router": {},
    "eas": {
      "projectId": "0c5380e2-0b06-49ab-a05e-9ae4421b2f1f"
    }
  }
}
